{
  "name": "@graveshift/server",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../shared/src src/main.ts",
    "start": "NODE_ENV=production node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke/runSmokeBots.ts",
    "migrate:admin": "node scripts/migrateAdminSettings.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@graveshift/shared": "workspace:*",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/ws": "^8.18.2"
  }
}
